# OpenRouter: use a regular inference key, not a management key.
MUSIC_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_API_KEY=

# Optional local settings.
BEAT_PORT=4318
BEAT_DIAGNOSTICS=0

# Alternative: MUSIC_PROVIDER=codex, with `codex login` completed.
# CODEX_PATH=/absolute/path/to/codex
